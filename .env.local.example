# ForgeLoop Frontend Configuration
# Copy this file to .env.local and configure the values

# Set to 'true' to use the real backend server instead of simulation
VITE_USE_REAL_BACKEND=false

# Backend API URL (only needed when VITE_USE_REAL_BACKEND=true)
VITE_API_URL=http://localhost:3001

# WebSocket URL (only needed when VITE_USE_REAL_BACKEND=true)
VITE_WS_URL=ws://localhost:3001

# Gemini API Key (for simulation mode chat feature)
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
